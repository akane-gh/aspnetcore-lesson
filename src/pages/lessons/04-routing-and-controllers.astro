  .method-diagram {
    margin: 32px 0;
    padding: 28px;
    border: 1px solid #f0d8dc;
    background: #fff;
  }

  .route-flow figcaption,
  .method-diagram figcaption {
    margin-bottom: 20px;
    color: #70565e;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .route-flow__items {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }

  .route-flow__item {
    min-height: 105px;
    padding: 18px;
    border: 1px solid #fecdd3;
    background: #fff8f8;
    color: #881337;
  }

  .route-flow__item--request {
    background: #fff1f2;
  }

  .route-flow__item--action {
    border-color: #fda4af;
    background: #ffe4e6;
  }

  .route-flow__item span {
    display: block;
    margin-bottom: 8px;
    color: #9f1239;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .route-flow__item strong {
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .route-flow__arrow,
  .method-diagram__arrow {
    color: #e11d48;
    font-size: 1.4rem;
    font-weight: 800;
  }

  .route-parts {
    display: grid;
    margin: 28px 0;
    border-top: 1px solid #f0d8dc;
  }

  .route-parts div {
    display: grid;
    grid-template-columns: minmax(190px, 0.48fr) 1fr;
