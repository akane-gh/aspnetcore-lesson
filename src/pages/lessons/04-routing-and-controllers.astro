  }

  .route-examples,
  .resource-table {
    display: grid;
    margin: 30px 0;
    border: 1px solid #f0d8dc;
    background: #fff;
  }

  .route-examples > div {
    display: grid;
    grid-template-columns: minmax(150px, 0.45fr) 1fr;
    gap: 18px;
    align-items: center;
    padding: 15px 18px;
    border-bottom: 1px solid #f0d8dc;
  }

